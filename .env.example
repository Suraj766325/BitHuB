# =====================================================================
# Google Apps Script Environment Configuration (Example Template)
# =====================================================================
# Copy this file to .env.local and fill in the actual deployment URLs:
#   cp .env.example .env.local
#
# When deploying to Vercel, add these variables in:
#   Vercel Dashboard -> Project Settings -> Environment Variables
# =====================================================================

# 1. Feedback & Poll Submissions Script (Option 2)
# Used in: bit-mesra/feedback.html, bit-mesra/index.html (Polls)
APPS_SCRIPT_FEEDBACK_KEY=your_feedback_Deployment_id_here
APPS_SCRIPT_FEEDBACK_URL=https://script.google.com/macros/s/your_feedback_deployment_id_here/exec

# 2. Analytics & Click Tracking Script (Option 1)
# Used in: bit-mesra/event.html, bit-mesra/index.html (Trends & Analytics)
APPS_SCRIPT_ANALYTICS_KEY=your_analytics_deployment_id_here
APPS_SCRIPT_ANALYTICS_URL=https://script.google.com/macros/s/your_analytics_deployment_id_here/exec

# Platform App Script Service Flag (set to false to enable live services)
APPS_SCRIPT_PAUSED=false
